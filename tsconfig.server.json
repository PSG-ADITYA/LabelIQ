{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* NodeNext resolution */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,

    /* Strictness & Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "api/**/*.ts",
    "server/**/*.ts"
  ]
}
