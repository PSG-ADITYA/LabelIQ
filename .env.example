# ============================================================================
# LabelIQ Studio 4.0 — Environment Configuration
# Copy this file to .env or .env.labeliq for local execution
# NEVER commit private keys or API secrets to version control
# ============================================================================

# Backend Server Port (Default: 5000)
PORT=5000

# Public Application URL (Used in QR Code Traceability payloads)
# In production, set to your live HTTPS domain (e.g. https://labeliq.farm)
PUBLIC_APP_URL=http://localhost:5175

# ----------------------------------------------------------------------------
# Google Gemini Generative AI Configuration
# ----------------------------------------------------------------------------
# Server-side API key for multimodal packaging OCR and natural-language drafting.
# Supported Models: gemini-3.5-flash, gemini-3.8-flash
# If left blank, LabelIQ automatically operates in 100% offline deterministic rule-based mode.
GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# Supabase Cloud Database & Storage (Optional)
# ----------------------------------------------------------------------------
# If configured, LabelIQ persists products, batches, and audit logs to PostgreSQL.
# If unconfigured, LabelIQ falls back seamlessly to local SQLite (labeliq.db).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SERVER-ONLY: Used for admin RLS provisioning and backend batch persistence.
# NEVER expose this key in client code or browser Vite environment variables!
SUPABASE_SERVICE_ROLE_KEY=

